  "languages": ["nl"],
  "notes": "Seed list for the Rechtspraak.nl connector. Dutch is a compounding language: many terms occur inside compounds (gewasbeschermingsmiddelenrichtlijn, bestrijdingsmiddelengebruik), so several stems use match=substring deliberately. Weight 3 = qualifies alone; weight 2 = strong; weight 1 = contextual only. Precision and recall to be reviewed against the first full ingestion run before this list is frozen. Revision 1.0.1 (issue #20): case_sensitive applies to a term and all of its aliases, so acronyms and prose words can never share a term. nl-ddt and nl-ctgb were splitting that rule and would have missed a sentence-initial 'Lindaan' or a lower-cased 'college voor de toelating'.",
  "scoring": {
    "min_score": 3,
    "count_term_once": true,
    "fields": {
      "title": 1.5,
      "abstract": 1.5,
      "subject": 1.0,
      "full_text": 1.0
    }
  },
  "terms": [
    { "id": "nl-pesticide", "term": "pesticide", "lang": "nl", "category": "product_class", "weight": 3, "match": "substring", "aliases": ["pesticiden"], "note": "substring also catches 'pesticidengebruik', 'pesticidenrichtlijn'" },
