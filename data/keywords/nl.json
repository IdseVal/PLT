    { "id": "nl-ctgb", "term": "Ctgb", "lang": "nl", "category": "authority", "weight": 3, "match": "word", "case_sensitive": true, "aliases": ["CTB"], "note": "Acronyms only; the spelled-out name is nl-college-toelating, which must stay case-insensitive." },
    { "id": "nl-college-toelating", "term": "College voor de toelating van gewasbeschermingsmiddelen en biociden", "lang": "nl", "category": "authority", "weight": 3, "match": "phrase", "aliases": ["College voor de toelating van bestrijdingsmiddelen"], "note": "Case-insensitive: Dutch judgments routinely write 'het college voor de toelating van gewasbeschermingsmiddelen en biociden' in lower case mid-sentence." },
    { "id": "nl-nvwa-gewas", "term": "NVWA", "lang": "nl", "category": "authority", "weight": 0.5, "match": "word", "case_sensitive": true, "note": "Contextual: the NVWA appears across food and animal law. Only meaningful alongside a pesticide term. Acronym only; the spelled-out name is nl-voedsel-warenautoriteit." },
