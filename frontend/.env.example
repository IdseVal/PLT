##
## PLT frontend configuration
##
## Copy to `.env.local` (git-ignored) and adjust. Only variables prefixed with `VITE_` are
## exposed to the browser bundle, so never put a secret in this file: everything here ends
## up in the shipped JavaScript.
##

# Base URL the API client calls. Leave empty to use the same origin as the site, which is
# what the dev-server proxy and a single-origin deployment both rely on. Set an absolute
# URL (https://api.plt.wur.nl/api) when the API is served from another host - that origin
# must then be listed in the backend's PLT_CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=/api

# Per-request timeout in milliseconds for API calls.
VITE_API_TIMEOUT_MS=15000

# Dev server only: port, and the backend the /api proxy forwards to.
VITE_DEV_PORT=5173
VITE_DEV_API_PROXY=http://127.0.0.1:5000
