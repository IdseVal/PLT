##
## PLT backend configuration
##
## Copy to `.env` (git-ignored) and adjust. Every variable below maps onto a field of
## `plt.config.Settings`; the values shown are the built-in defaults unless marked
## otherwise. Nothing here is a secret: PLT_SECRET_KEY is a placeholder that the settings
## validator refuses to accept when PLT_APP_ENV=production.
##

# --- Application ---------------------------------------------------------------------
# Human-readable application name, used in logs and the outbound User-Agent.
PLT_APP_NAME="Pesticide Litigation Tracker"
# development | testing | production
PLT_APP_ENV=development
# Flask debug mode. Must be false in production (enforced by the settings validator).
PLT_DEBUG=false
# Flask secret key. PLACEHOLDER - generate per deployment with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# and supply it through the deployment secret store, never through a committed file.
PLT_SECRET_KEY=change-me-in-production

# --- Database ------------------------------------------------------------------------
# SQLAlchemy URL. SQLite in development; PostgreSQL in deployment, e.g.
#   postgresql+psycopg://plt:<password>@localhost:5432/plt
PLT_DATABASE_URL=sqlite+pysqlite:///./plt.db
# Echo emitted SQL to the logger. Debugging aid only; noisy and slow.
PLT_DATABASE_ECHO=false
# Connection pool size (1-100). Ignored by SQLite.
PLT_DATABASE_POOL_SIZE=5
# Seconds to wait for a pooled connection before failing (1-300).
PLT_DATABASE_POOL_TIMEOUT_SECONDS=30

# --- HTTP API ------------------------------------------------------------------------
# Base path every API blueprint is mounted under.
PLT_API_PREFIX=/api
# Comma-separated origins allowed to call the API. Set to the deployed frontend origin;
# the default is the Vite dev server.
PLT_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Pagination defaults and hard server-side bounds (architecture section 5).
PLT_PAGE_SIZE_DEFAULT=20
PLT_PAGE_SIZE_MAX=100
PLT_LATEST_LIMIT_DEFAULT=20
PLT_LATEST_LIMIT_MAX=50
# Rate limiting. Keep enabled on any public deployment.
PLT_RATE_LIMIT_ENABLED=true
PLT_RATE_LIMIT_DEFAULT="120 per minute"
PLT_RATE_LIMIT_EXPORT="10 per hour"
PLT_RATE_LIMIT_REVIEW="30 per minute"
# Rate limiter storage. memory:// is per-process; use redis://<host>:6379/0 when running
# more than one worker.
PLT_RATE_LIMIT_STORAGE_URI=memory://

# --- Review queue --------------------------------------------------------------------
# Bearer token authenticating /api/reviews, the content manager's queue of borderline
# cases (core document 2.7). Leave it unset and the endpoints stay disabled: the queue
# lists cases a rejection has unpublished, and its decision endpoint can unpublish more.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# PLT_REVIEW_API_TOKEN=
PLT_REVIEW_PAGE_SIZE_DEFAULT=20

# --- Public site ---------------------------------------------------------------------
# Origin the site is served from. Every link the tracker puts in an email is built from it,
# so in a deployment this is the public address, not localhost.
PLT_SITE_BASE_URL=http://localhost:5173

# --- Mail ----------------------------------------------------------------------------
# console | file | smtp
# console (the default) renders each message to the log and file writes it to an .eml under
# PLT_MAIL_OUTBOX_DIR. Neither opens a network connection, so the whole subscription flow can
# be exercised locally without a single real address receiving anything. Sending real mail is
# always a deliberate change to smtp; production refuses to start on console.
PLT_MAIL_BACKEND=console
PLT_MAIL_FROM="Pesticide Litigation Tracker <plt@wur.nl>"
# PLT_MAIL_REPLY_TO=plt@wur.nl
PLT_MAIL_OUTBOX_DIR=./outbox
# Where the review-queue notification goes (core document 2.7). Unset means no notification
# is sent; the queue itself and /api/reviews are unaffected either way.
# PLT_ADMIN_EMAIL=content-manager@wur.nl
# SMTP, used only when PLT_MAIL_BACKEND=smtp. The password belongs in the deployment secret
# store, never in a committed file.
# PLT_SMTP_HOST=smtp.wur.nl
PLT_SMTP_PORT=587
# PLT_SMTP_USERNAME=
# PLT_SMTP_PASSWORD=
# STARTTLS on 587, implicit TLS on 465. They are alternatives; enabling both is rejected.
PLT_SMTP_STARTTLS=true
PLT_SMTP_SSL=false
PLT_SMTP_TIMEOUT_SECONDS=30
# Most review items listed in one admin notification; a larger batch is reported as a count.
PLT_ADMIN_NOTICE_MAX_ITEMS=50

# --- Mailing list --------------------------------------------------------------------
# Key the confirmation and unsubscribe tokens are derived from (HMAC-SHA256). Defaults to
# PLT_SECRET_KEY. Rotating either invalidates every link already sent, so a subscriber would
# have to unsubscribe from the website instead: rotate deliberately.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# PLT_SUBSCRIPTION_TOKEN_SECRET=
# How long a confirmation link stays usable. An address that never confirms is never sent a
# digest (double opt-in) and its row can be purged.
PLT_SUBSCRIPTION_CONFIRM_TTL_HOURS=72
# Shortest interval between two transactional messages to one address. This is what stops the
# public subscribe endpoint being used to mail-bomb a third party: a second submission inside
# the window sends nothing, and answers exactly as the first did.
PLT_SUBSCRIPTION_NOTICE_INTERVAL_SECONDS=3600
# Rate limits for the public subscription endpoints, per client. The subscribe limit governs
# the two endpoints that send mail to an address the caller supplied.
PLT_RATE_LIMIT_SUBSCRIBE="5 per hour"
PLT_RATE_LIMIT_SUBSCRIPTION_TOKEN="30 per hour"
# Digest window when `plt digest` is run without --since, and the shape of one message.
PLT_DIGEST_PERIOD_DAYS=7
PLT_DIGEST_MAX_CASES=50
PLT_DIGEST_BATCH_SIZE=50

# --- Outbound HTTP (source connectors) -----------------------------------------------
# Contact address advertised to the source endpoints. Set this to a mailbox that is read.
PLT_HTTP_CONTACT_EMAIL=plt@wur.nl
# User-Agent template; placeholders: {version} {repository} {contact}
PLT_HTTP_USER_AGENT_TEMPLATE="PLT/{version} (+{repository}; {contact})"
PLT_HTTP_REPOSITORY_URL=https://github.com/IdseVal/PLT
# Per-request timeout in seconds.
PLT_HTTP_TIMEOUT_SECONDS=30
# Retries on 429 and 5xx, with exponential backoff and jitter between them.
PLT_HTTP_MAX_RETRIES=5
PLT_HTTP_BACKOFF_INITIAL_SECONDS=1
PLT_HTTP_BACKOFF_MAX_SECONDS=60
# A Retry-After header is always obeyed as the source sent it, never shortened. This is the
# longest such pause a run will sit through; beyond it the run ends and the next scheduled
# one resumes the window, so the source is left alone for as long as it asked.
PLT_HTTP_RETRY_AFTER_MAX_SECONDS=900
# Politeness throttle. These are public research endpoints - do not raise without reason.
PLT_HTTP_REQUESTS_PER_SECOND=2

# --- Pipeline ------------------------------------------------------------------------
# Documents processed and committed per batch; keeps memory flat on long runs.
PLT_PIPELINE_BATCH_SIZE=50
# Result-page size requested from source endpoints during discovery.
PLT_PIPELINE_PAGE_SIZE=100
# Where `plt ingest --dry-run` writes its match report. Git-ignored; relative to the repo.
PLT_PIPELINE_REPORT_DIR=./reports

# --- Source endpoints ----------------------------------------------------------------
PLT_RECHTSPRAAK_SEARCH_URL=https://data.rechtspraak.nl/uitspraken/zoeken
PLT_RECHTSPRAAK_CONTENT_URL=https://data.rechtspraak.nl/uitspraken/content
PLT_RECHTSPRAAK_VOCABULARY_URL=https://data.rechtspraak.nl/Waardelijst
# Restrict Rechtspraak discovery to ECLIs that carry text (return=DOC). The excluded
# registrations have no summary and no body, so they cannot match any keyword.
PLT_RECHTSPRAAK_DOCUMENTS_ONLY=true
PLT_EURLEX_SPARQL_URL=https://publications.europa.eu/webapi/rdf/sparql
PLT_EURLEX_CELLAR_BASE_URL=http://publications.europa.eu/resource/celex
# Since 1 January 2026 one CELLAR search returns at most this many results, so discovery
# walks date windows and halves any window that reaches the cap.
PLT_EURLEX_MAX_RESULTS=10000
PLT_EURLEX_WINDOW_DAYS=30
PLT_EURLEX_MIN_WINDOW_SECONDS=3600
# Manifestation languages to retrieve, in order of preference (ISO 639-3). A case with none
# of them falls back to its procedural language; each language becomes its own document row.
PLT_EURLEX_LANGUAGES=eng
# CDM resource types discovery enumerates: the decisions themselves, not the Official
# Journal notices or the editorial summaries of the same case.
PLT_EURLEX_RESOURCE_TYPES=JUDG,ORDER,OPIN_AG,JUDG_EXTRACT
# modification | document. 'modification' is the incremental route the weekly job needs.
# 'document' walks the date of the decision itself, for backfilling a historical period,
# and leaves the incremental checkpoint alone.
PLT_EURLEX_DISCOVERY_DATE=modification

# --- Data files ----------------------------------------------------------------------
# Defaults resolve to the repository's data/ directory. Override when the backend runs
# from an installed wheel rather than from a checkout.
# PLT_DATA_DIR=/srv/plt/data
# PLT_KEYWORDS_DIR=/srv/plt/data/keywords

# --- Logging -------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
PLT_LOG_LEVEL=INFO
# json for deployments (one JSON object per line), text for local work.
PLT_LOG_FORMAT=json
